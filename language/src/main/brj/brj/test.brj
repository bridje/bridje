ns: brj.test
  import:
    java.util:
      as(ArrayList, AL)

decl: .test Bool

decl: .form Form
decl: .message Str?
tag: Failure{.form, .message}

// What a test threw, if anything: whatever the body raised, so the result is generic in it.
decl: .failures AL(Failure)
decl: [e] .exn e
tag: [e] TestResult{.failures, .exn(e)}

decl: [a] AL/new() AL(a)
decl: [a] AL/.add(a) Bool

def: _makeCollector() AL/new()

def: _collectorAdd(c, x)
  AL/.add(c, x)
  nil

defx: _recordFailure(Form, Str?) Nothing?

defmacro: is(form)
  `(unless ~form
     _recordFailure('~form, nil))

defmacro: runTest(testQsym)
  `(let [cell# _makeCollector()
         exn# try:
                withFx: [_recordFailure fn: h#(f#, m#)
                                          _collectorAdd(cell#, Failure{.form f#, .message m#})]
                  (~testQsym)
                nil
                catch:
                  a# a#]
     TestResult{.failures cell#, .exn exn#})
